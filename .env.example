# Telegram Bot Token from @BotFather (https://t.me/BotFather)
BOT_TOKEN=7123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter API Key for AI Fallback Mode (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MongoDB Connection String (Atlas or Local MongoDB)
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Optional MongoDB Database Name (defaults to tg_business_autoresponder)
MONGO_DB_NAME=tg_business_autoresponder

# Default AI model for auto-replies (Optional - default: google/gemini-2.5-flash)
DEFAULT_AI_MODEL=google/gemini-2.5-flash

# Default custom auto-reply message (Optional - supports plain text, invite links https://t.me/..., and multi-bubble separation with '---')
# Example multi-bubble: "Hello! Thanks for reaching out. --- Join our group: https://t.me/+xxx --- Let us know if you need help!"
DEFAULT_CUSTOM_MESSAGE=Hello! Thanks for connecting. How can I assist you today?

# Port (Optional - Render automatically sets $PORT)
PORT=8000
