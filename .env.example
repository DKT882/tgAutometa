# Telegram API Credentials (get from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# OpenRouter API Key (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx

# Optional default model (defaults to google/gemini-2.5-flash)
DEFAULT_AI_MODEL=google/gemini-2.5-flash

# Telethon StringSessions for profile slots 1 to 5
SESSION_1=1BJWap1wBu...
SESSION_2=
SESSION_3=
SESSION_4=
SESSION_5=

# Port assigned by Render or local dev
PORT=8000

